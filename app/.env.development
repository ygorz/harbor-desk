# This env file is intended for developing on your local computer against local
# Ontology dev server.
# Use .env.remote for local development against a production Foundry host running
# remotely.
# To set up development in Foundry's Code Workspaces, see .env.code-workspaces.
# To deploy your application to production, see .env.production.
# Note that .env.code-workspaces is only present for projects that were set up
# using the "Bootstrap in Foundry" option in Developer Console.


# This URL is the URL your users will be redirected back to after signing in.
# This URL must exactly match one of the URLs listed in the "OAuth & scopes"
# page of Developer Console.
#
# If your application in development is not hosted on port 8080, you will need
# to change this URL here and in Developer Console.

VITE_FOUNDRY_REDIRECT_URL=http://localhost:8080/auth/callback


# Foundry API URL for development against local Ontology dev server.
# This value will be overridden by vite to point to local ontology dev server.

VITE_FOUNDRY_API_URL=http://localhost:8080


# Using dummy Client ID for development against local Ontology dev server.
# VITE_USE_MOCK_AUTH=true in this file enables mock authentication.

VITE_FOUNDRY_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Using dummy Ontology RID for development against local Ontology dev server.

VITE_FOUNDRY_ONTOLOGY_RID=ri.ontology.main.ontology.0


# Use mock authentication when developing against local Ontology dev server.

VITE_USE_MOCK_AUTH=true
