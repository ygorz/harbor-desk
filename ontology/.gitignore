node_modules
dist
build
codegen
# osdk-output is generated by codegen; keep only the .gitkeep so the @ontology/sdk
# dependency target directory exists before the first install, which runs before codegen.
osdk-output/*
!osdk-output/ontology
osdk-output/ontology/*
!osdk-output/ontology/.gitkeep
src/generated-imports/**/*.ts
src/generated-imports/**/*.js
src/generated-imports/codegen
index.ts
